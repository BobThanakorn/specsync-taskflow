{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecSync Traceability Matrix",
  "type": "object",
  "required": ["generated_at", "rows"],
  "properties": {
    "generated_at": { "type": "string" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "test_covered", "code_refs"],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^R-\\d{2}$" },
          "requirement_title": { "type": "string" },
          "status": { "enum": ["implemented", "missing"] },
          "test_covered": { "type": "boolean" },
          "code_refs": { "type": "array", "items": { "type": "string" } },
          "test_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
